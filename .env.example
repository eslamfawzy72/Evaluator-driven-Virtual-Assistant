REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Teammate 2 will use this for the Generator/Evaluator LLMs
ANTHROPIC_API_KEY=

LLM_MODEL=your-model
LLM_TEMPERATURE=0.2
LLM_API_KEY=your-api-key

HF_TOKEN=hf_token

# LangSmith monitoring (optional) -- get a key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=evaluator-generator-platform
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
